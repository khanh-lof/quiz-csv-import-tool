    "@angular/router": "^20.3.0",
    "ng-zorro-antd": "^20.4.1",
    "openai": "^6.47.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.11",
    "@angular/cli": "^20.3.11",
    "@angular/compiler-cli": "^20.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "baseline-browser-mapping": "^2.11.14",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
