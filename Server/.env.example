# Copy to .env for local development (go run ./cmd/server reads it; real env vars win).

PORT=7071

# QuizTool's public URL, e.g. https://quiztool.example.com. Added to the origins the downloadable
# Wayground extension runs on (http://localhost:4200 is always there). Read when the extension zip is packed.
APP_ORIGIN=

# PostgreSQL; the server creates its tables on start. On Render the Blueprint sets it from the database.
DATABASE_URL=postgres://quiz:quiz@localhost:5432/quiz?sslmode=disable

# At least 32 bytes (256 bits); the server refuses to start otherwise. E.g. openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-bytes-or-more
# Both default to quiztool / quiztool-api and are always validated.
JWT_ISSUER=quiztool
JWT_AUDIENCE=quiztool-api
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
MAX_REFRESH_TOKENS_PER_USER=5

# Sent as the X-Admin-Key header to POST /api/users. Empty disables the endpoint.
ADMIN_API_KEY=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Formatted mode ("Hỏi chữ Hán"), and Auto mode when LLM_INTELLIGENCE_MODELS is empty.
LLM_MODEL=gpt-5.6-luna
# Auto mode: the models behind "Độ thông minh" Thấp and Cao, in that order. Must list exactly 2, or be empty.
LLM_INTELLIGENCE_MODELS=gpt-5.6-luna,gpt-5.6-sol

CALL_COUNT_ACCEPTED_IN_A_ROUND=2
ROUND_MINUTES=1

# Login: at most this many password checks per username in a window of this many minutes; more answer 429.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Game: seconds per question of stages 1 to 6, in order, in the standard time mode ("extra" time is 1.5 times
# these, "unlimited" has none). Exactly 6 whole numbers, each 5 to 600; the server refuses to start otherwise.
# A shared quiz is timed by the server alone, so this is the only place the limits are set. Unset: 12,12,15,15,20,45.
GAME_STAGE_SECONDS=12,12,15,15,20,45
