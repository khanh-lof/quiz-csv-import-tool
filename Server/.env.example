# Copy to .env for local development (go run ./cmd/server reads it; real env vars win).

PORT=7071
# Exact origins allowed to call the API with credentials, comma-separated.
ALLOWED_ORIGINS=http://localhost:4200

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=QuizDb
MONGODB_COLLECTION=Users

# At least 32 bytes.
JWT_SECRET=change-me-to-a-long-random-string-of-32-bytes-or-more
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
MAX_REFRESH_TOKENS_PER_USER=5

# Sent as the X-Admin-Key header to POST /api/users. Empty disables the endpoint.
ADMIN_API_KEY=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Formatted mode ("Tiếng Việt + pinyin + chữ Hán là gì?"), and Auto mode when LLM_INTELLIGENCE_MODELS is empty.
LLM_MODEL=gpt-5.6-luna
# Auto mode: the models behind "Độ thông minh" Thấp and Cao, in that order. Must list exactly 2, or be empty.
LLM_INTELLIGENCE_MODELS=gpt-5.6-luna,gpt-5.6-sol

CALL_COUNT_ACCEPTED_IN_A_ROUND=2
ROUND_MINUTES=1
