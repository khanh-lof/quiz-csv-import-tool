{
  "manifest_version": 3,
  "name": "QuizTool → Wayground & Gimkit",
  "version": "0.2.0",
  "description": "Publishes the quiz QuizTool generates straight into your own Wayground or Gimkit account.",
  "permissions": ["storage"],
  "host_permissions": ["https://wayground.com/*", "https://www.gimkit.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:4200/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://wayground.com/*"],
      "js": ["common.js", "selectors.js", "wayground.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.gimkit.com/*"],
      "js": ["common.js", "gimkit-selectors.js", "gimkit.js"],
      "run_at": "document_idle"
    }
  ]
}
